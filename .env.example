# ---- Server ----
NODE_ENV=development
PORT=4000

# MongoDB (Atlas or local). Required in production.
# Example Atlas: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/bongololona
MONGODB_URI=

# 64+ random chars. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Exact origins allowed to call the API (comma separated, no trailing slash).
# Dev defaults: storefront http://localhost:5001 + dashboard http://localhost:3001
APP_ORIGIN=

# "lax" and a shared parent domain (COOKIE_DOMAIN) are required when the
# storefront is hosted on a different site than the API.
COOKIE_SAMESITE=
COOKIE_DOMAIN=

# Set to "1" only for local development without a MongoDB install (uses in-memory DB)
DB_MEMORY=

# Seed admin account
ADMIN_EMAIL=admin@bongololona.local
ADMIN_PASSWORD=

# HMAC secret for payment-gateway webhooks (bKash/Nagad/SSLCommerz later)
PAYMENT_WEBHOOK_SECRET=

# Set only when behind a reverse proxy (nginx / Cloudflare / Render)
TRUST_PROXY=

# Where the dashboard build lives (default: backend/admin/dist)
ADMIN_DIR=
